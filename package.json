{
  "name": "wilsee",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:journey": "node tests/journey.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:quality": "node tests/quality.mjs",
    "test:upgrades": "node tests/upgrades.mjs",
    "test:responsive": "node tests/responsive-upgrades.mjs",
    "test:map-lifecycle": "node tests/map-lifecycle.mjs",
    "test:population": "node tests/population.mjs",
    "test:unit": "playwright test tests/domain.spec.ts --reporter=line --workers=1",
    "test:accessibility": "node tests/accessibility.mjs",
    "test:stress": "node tests/stress.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:privacy": "node tests/privacy.mjs",
    "test:visual": "node tests/visual-audit.mjs final",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src tests README.md package.json vite.config.ts index.html",
    "format:check": "prettier --check src tests README.md package.json vite.config.ts index.html"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
